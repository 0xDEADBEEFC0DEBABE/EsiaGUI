     return true;
 }
 
+// Win32 key state is per thread (GetKeyState() reflects the calling thread's message queue). Input may be
+// replayed on a different thread than the window's (WGT: window thread + render thread), so the key state
+// captured with each message on the window thread can be supplied here (256 entries, GetKeyboardState layout).
+static thread_local const unsigned char* g_KeyStateSnapshot = nullptr;
+
+void ImGui_ImplWin32_SetKeyState(const unsigned char* keys) { g_KeyStateSnapshot = keys; }
+
 static bool IsVkDown(int vk)
 {
+    if (g_KeyStateSnapshot)
+        return (g_KeyStateSnapshot[vk & 0xFF] & 0x80) != 0;
     return (::GetKeyState(vk) & 0x8000) != 0;
 }
 
