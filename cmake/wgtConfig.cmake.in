# WGT UI package configuration.
#
#   find_package(wgt 1.1 CONFIG REQUIRED)
#   target_link_libraries(my_game PRIVATE wgt::wgt)
#
# wgt::wgt brings the include directories (wgt/ and WGT's Dear ImGui headers), the IMGUI_USER_CONFIG define,
# C++20 and /utf-8. Copy wgt.dll next to your executable (see WGT_RUNTIME_DLL / docs/INTEGRATION.md).
@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/wgtTargets.cmake")

# Path of wgt.dll (for post-build copies: $<TARGET_FILE:wgt::wgt> works as well).
get_target_property(WGT_RUNTIME_DLL wgt::wgt IMPORTED_LOCATION_RELEASE)

check_required_components(wgt)
