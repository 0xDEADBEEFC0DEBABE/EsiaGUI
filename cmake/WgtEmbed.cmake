# Script mode: cmake -DOUT=<header> -DPAIRS=sym=file|sym=file -P WgtEmbed.cmake
string(REPLACE "|" ";" _pairs "${PAIRS}")
set(_content "// Generated by WgtEmbed.cmake - do not edit.\n#pragma once\n#include <cstddef>\n\n")
foreach(_pair ${_pairs})
    string(FIND "${_pair}" "=" _eq)
    string(SUBSTRING "${_pair}" 0 ${_eq} _sym)
    math(EXPR _start "${_eq} + 1")
    string(SUBSTRING "${_pair}" ${_start} -1 _file)
    file(READ "${_file}" _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _bytes "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _arr "${_hex}")
    string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],)" "\\1\n" _arr "${_arr}")
    string(APPEND _content "static const unsigned char ${_sym}[] = {\n${_arr}0x00 };\nstatic const size_t ${_sym}Size = ${_bytes};\n\n")
endforeach()
file(WRITE "${OUT}.tmp" "${_content}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
