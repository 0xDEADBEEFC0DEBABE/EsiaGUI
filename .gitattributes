# normalize text to LF in the repository; git picks the working-tree line endings per platform
* text=auto

# Visual Studio files keep CRLF
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf

# binaries
*.ttf binary
*.otf binary
*.png binary
*.lib binary
*.dll binary
*.exe binary
# Esia shader library: generated by tools/shaders/build_shaders.py, which writes LF and whose --check compares
# bytes - so every generated text file (the table included) is LF in every checkout, the blobs are binary
src/esia/shaders/generated/** linguist-generated=true text eol=lf
src/esia/shaders/generated/**/*.spv binary
src/esia/shaders/generated/**/*.dxbc binary
src/esia/shaders/generated/**/*.dxil binary
# conformance goldens of the null backend: recorded command streams, compared line by line
tests/conformance/golden/**/*.log text eol=lf
