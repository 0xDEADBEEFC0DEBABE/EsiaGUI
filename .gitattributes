# normalize text to LF in the repository; git picks the working-tree line endings per platform
* text=auto

# Visual Studio files keep CRLF
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf

# binaries
*.ttf binary
*.otf binary
*.png binary
*.lib binary
*.dll binary
*.exe binary
# Esia shader library: generated by tools/shaders/build_shaders.py (text formats stay diffable)
src/esia/shaders/generated/** linguist-generated=true
src/esia/shaders/generated/**/*.spv binary
src/esia/shaders/generated/**/*.dxbc binary
src/esia/shaders/generated/**/*.dxil binary
src/esia/shaders/generated/**/*.glsl text eol=lf
src/esia/shaders/generated/**/*.essl text eol=lf
src/esia/shaders/generated/**/*.metal text eol=lf
